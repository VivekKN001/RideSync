# Copy to .env (git ignores it) and change every value. docker compose and ridesync read it.
# The Grafana admin password guards the only login a visitor can reach through `python -m ridesync.web.share`.
RIDESYNC_DB_PASSWORD=change-me
GRAFANA_DB_PASSWORD=change-me-too
GRAFANA_ADMIN_PASSWORD=change-me-as-well

# Optional: where the monthly TLC trip files live (~0.5 GB each; python -m ridesync.data.fetch --tlc puts them here).
# Default data/raw. Point it at a bigger disk, e.g. RIDESYNC_TLC_DIR=E:\RideSync-Data\nyc-tlc-trips
# RIDESYNC_TLC_DIR=
