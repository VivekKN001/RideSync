<!-- Small-footprint ClickHouse for a laptop: ~1 GB container, no system log tables. -->
<clickhouse>
    <max_server_memory_usage>800000000</max_server_memory_usage>
    <mark_cache_size>67108864</mark_cache_size>
    <uncompressed_cache_size>0</uncompressed_cache_size>
    <index_mark_cache_size>0</index_mark_cache_size>
    <max_concurrent_queries>32</max_concurrent_queries>
    <logger><level>warning</level></logger>

    <query_log remove="1"/>
    <query_thread_log remove="1"/>
    <query_views_log remove="1"/>
    <trace_log remove="1"/>
    <metric_log remove="1"/>
    <asynchronous_metric_log remove="1"/>
    <part_log remove="1"/>
    <text_log remove="1"/>
    <session_log remove="1"/>
    <processors_profile_log remove="1"/>
    <opentelemetry_span_log remove="1"/>
    <asynchronous_insert_log remove="1"/>
    <backup_log remove="1"/>
    <error_log remove="1"/>

    <!-- New Kafka consumer groups start from the oldest retained message. -->
    <kafka>
        <auto_offset_reset>smallest</auto_offset_reset>
        <!-- librdkafka read-ahead per partition (default 64 MB) -->
        <queued_max_messages_kbytes>8192</queued_max_messages_kbytes>
    </kafka>
</clickhouse>
